# Copy to local.env (ignored) and fill in. scripts/env.sh loads it; values
# already in the environment win. Relative values resolve from this directory.
# A checkout of zunekit at the commit named in zunekit.pin.
LAUNCHER_ZUNEKIT=""
# Directory holding x86_64-aros-gcc for mainline (ABIv1), and the matching SDK's Developer drawer.
LAUNCHER_TOOLCHAIN_V1=""
LAUNCHER_SDK_V1=""
# The same for ABIv11 (the SDK's Development drawer).
LAUNCHER_TOOLCHAIN_ABIV11=""
LAUNCHER_SDK_ABIV11=""
# Raspberry Pi AArch64 (aarch64-aros-gcc) and its SDK.
LAUNCHER_TOOLCHAIN_RASPI=""
LAUNCHER_SDK_RASPI=""
